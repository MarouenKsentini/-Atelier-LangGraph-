# Clé API Google AI Studio : https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Modèle principal, puis modèles de secours (quota gratuit = 20 req/jour PAR modèle).
# Les modèles Gemini 3+ ignorent `temperature`, on n'en passe donc pas.
GOOGLE_MODEL=gemini-3.6-flash
GOOGLE_MODEL_SECOURS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.8-flash

# Serveur MCP Facturation (projet séparé, non fourni dans ce dépôt)
MCP_URL=http://127.0.0.1:8000/mcp
